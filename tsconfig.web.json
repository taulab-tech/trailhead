{
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/web/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts",
    // The query layer, the importer and the matching engine have no platform
    // dependencies and are compiled into the browser build as well.
    "src/main/**/*"
  ],
  // Everything under src/main that genuinely needs Electron or Node. The web
  // build never imports these; if one of them turns up in the browser bundle,
  // that's the bug this list is here to catch.
  "exclude": [
    "src/main/index.ts",
    "src/main/ipc.ts",
    "src/main/backup.ts",
    "src/main/dataDir.ts",
    "src/main/db/desktop.ts",
    "src/main/pythonSearch.ts",
    "src/main/workbooksDesktop.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
